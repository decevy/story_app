# Example environment variables — copy to .env.development.local to override secrets or machine-specific URLs.
# For npm run dev, prefer the committed `.env.development` (same-origin proxy → API on https://localhost:7011).

# SPA origin in dev — requests go through Vite; /api and /pulseHub proxy to StoryApp.Api (https profile).
VITE_API_URL=http://localhost:3000

# Hub on same origin — WebSocket upgrades are proxied to the API hub at /pulseHub.
VITE_HUB_URL=http://localhost:3000/pulseHub
