# Local dev with Vite proxy (see vite.config.ts):
# Browser uses same-origin http://localhost:3000 → /api and /pulseHub proxied to https://localhost:7011.
# Run the API with the https launch profile so it listens on 7011.

VITE_API_URL=http://localhost:3000
VITE_HUB_URL=http://localhost:3000/pulseHub
