{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "storyapp-ng": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "prefix": "sa"
        },
        "@schematics/angular:directive": {
          "prefix": "sa"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "sa",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "storyapp-ng:build:production"
            },
            "development": {
              "buildTarget": "storyapp-ng:build:development"
            },
            "e2e": {
              "buildTarget": "storyapp-ng:build:development",
              "prebundle": false
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 3000,
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": ["src/app/**/*.spec.ts"],
            "coverageReporters": ["text-summary", "html", "lcovonly"],
            "coverageThresholds": {
              "statements": 90,
              "branches": 85,
              "functions": 90,
              "lines": 90
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
