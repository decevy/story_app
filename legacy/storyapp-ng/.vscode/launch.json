{
  // Debug the app in Chrome against `npm start` (port 3000). Unit tests debug through the
  // Vitest extension; E2E tests through the Playwright extension.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:3000/"
    }
  ]
}
